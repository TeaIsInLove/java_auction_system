<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      styleClass="card"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bai_tap_lon.Controllers.AuctionBidController">

    <padding>
        <Insets top="14.0"
                right="14.0"
                bottom="14.0"
                left="14.0"/>
    </padding>

    <children>

        <Label text="Thao tac phien"
               styleClass="section-title"/>

        <Label fx:id="selectedAuctionLabel"
               text="Chua chon phien"
               wrapText="true"
               styleClass="subtitle"/>

        <GridPane hgap="8.0"
                  vgap="9.0">

            <columnConstraints>
                <ColumnConstraints minWidth="98.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <children>

                <Label text="Nguoi dat"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="bidderField"
                           promptText="Bidder username"
                           styleClass="input-field"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Gia dat"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="bidAmountField"
                           promptText="1300"
                           styleClass="input-field"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

            </children>

        </GridPane>

        <HBox alignment="CENTER_RIGHT"
              spacing="8.0">

            <Button fx:id="startButton"
                    text="Bat dau"
                    onAction="#handleStartAuction"
                    styleClass="info-button"/>

            <Button fx:id="bidButton"
                    text="Dat gia"
                    onAction="#handlePlaceBid"
                    styleClass="success-button"/>

            <Button fx:id="endButton"
                    text="Ket thuc"
                    onAction="#handleEndAuction"
                    styleClass="danger-button"/>

        </HBox>

    </children>

</VBox>