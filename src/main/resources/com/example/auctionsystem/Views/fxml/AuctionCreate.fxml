<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      styleClass="card"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bai_tap_lon.Controllers.AuctionCreateController">

    <padding>
        <Insets top="14.0"
                right="14.0"
                bottom="14.0"
                left="14.0"/>
    </padding>

    <children>

        <Label text="Tạo phiên"
               styleClass="dark-label"/>

        <GridPane hgap="8.0"
                  vgap="9.0">

            <columnConstraints>
                <ColumnConstraints minWidth="98.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <children>

                <Label text="Loại"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="itemTypeCombo"
                          maxWidth="1.7976931348623157E308"
                          styleClass="input-field"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Sản Phẩm"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="itemNameField"
                           promptText="Ten item"
                           styleClass="input-field"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Mô tả"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextArea fx:id="descriptionArea"
                          prefRowCount="3"
                          promptText="Mo ta ngan"
                          wrapText="true"
                          styleClass="input-area"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Giá đấu"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="startingPriceField"
                           promptText="1000"
                           styleClass="input-field"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Người bán"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="sellerField"
                           promptText="Seller username"
                           styleClass="input-field"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

                <Label text="Thông tin thêm"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"/>

                <TextField fx:id="extraInfoField"
                           styleClass="input-field"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="5"/>

                <Label text="Bắt đầu"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="6"/>

                <HBox spacing="8.0"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="6">

                    <DatePicker fx:id="startDatePicker"
                                styleClass="input-field"
                                HBox.hgrow="ALWAYS"/>

                    <TextField fx:id="startTimeField"
                               prefWidth="74.0"
                               promptText="09:00"
                               styleClass="input-field"/>

                </HBox>

                <Label text="Kết thúc"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="7"/>

                <HBox spacing="8.0"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="7">

                    <DatePicker fx:id="endDatePicker"
                                styleClass="input-field"
                                HBox.hgrow="ALWAYS"/>

                    <TextField fx:id="endTimeField"
                               prefWidth="74.0"
                               promptText="18:00"
                               styleClass="input-field"/>

                </HBox>

            </children>

        </GridPane>

        <HBox alignment="CENTER_RIGHT"
              spacing="8.0">

            <Button text="Xóa"
                    onAction="#handleClearForm"
                    styleClass="secondary-button"/>

            <Button text="Tạo phiên"
                    onAction="#handleCreateAuction"
                    styleClass="primary-button"/>

        </HBox>

    </children>

</VBox>