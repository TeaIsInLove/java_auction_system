<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="820" prefWidth="1400"
            stylesheets="@../css/AuctionRoom.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.bai_tap_lon.Controllers.AuctionRoomController">

    <top>

        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">

            <padding>
                <Insets bottom="20" left="25" right="25" top="20" />
            </padding>

            <StackPane prefHeight="140" prefWidth="140" styleClass="image-box">
                <Label styleClass="image-icon" text="📦" />
            </StackPane>

            <VBox spacing="10">

                <Label fx:id="titleLabel" styleClass="auction-title" text="" />

                <Label fx:id="categoryLabel" styleClass="auction-category" text="" />

                <HBox spacing="30">

                    <VBox spacing="4">
                        <Label styleClass="info-label" text="Giá hiện tại" />
                        <Label fx:id="currentPriceLabel" styleClass="price-text" text="" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="info-label" text="Người dẫn đầu" />
                        <Label fx:id="leaderLabel" styleClass="leader-text" text="" />
                    </VBox>

                    <VBox spacing="4">
                        <Label styleClass="info-label" text="Kết thúc sau" />
                        <Label fx:id="timerLabel" styleClass="timer-text" text="" />
                    </VBox>

                </HBox>

            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="statusBadgeLabel" styleClass="live-badge" text="" />

        </HBox>

    </top>

    <center>

        <HBox spacing="20" styleClass="main-content">

            <padding>
                <Insets bottom="20" left="25" right="25" top="20" />
            </padding>

            <!-- Left panel: bid table + price trend chart -->
            <VBox spacing="18" styleClass="panel-card" HBox.hgrow="ALWAYS">

                <Label styleClass="section-title" text="Lịch sử đặt giá" />

                <TableView fx:id="bidTable" styleClass="bid-table" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="userColumn" prefWidth="220" text="Người dùng" />

                        <TableColumn fx:id="amountColumn" prefWidth="180" text="Giá đặt" />

                        <TableColumn fx:id="timeColumn" prefWidth="220" text="Thời gian" />

                        <TableColumn fx:id="bidStatusColumn" prefWidth="180" text="Trạng thái" />

                    </columns>

                </TableView>

                <!-- Bid price trend chart -->
                <Label styleClass="section-title" text="Xu hướng giá" />

                <LineChart fx:id="bidChart" prefHeight="180" animated="false" legendVisible="false">
                    <xAxis>
                        <NumberAxis label="Lượt đặt" forceZeroInRange="false" fx:id="chartXAxis" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Giá (triệu đ)" forceZeroInRange="false" fx:id="chartYAxis" />
                    </yAxis>
                </LineChart>

            </VBox>

            <!-- Right panel -->
            <VBox prefWidth="360" spacing="20">

                <!-- Bid action panel -->
                <VBox spacing="16" styleClass="panel-card">

                    <Label styleClass="section-title" text="Đặt giá" />

                    <Button fx:id="startSessionButton" maxWidth="Infinity" onAction="#handleStartSession"
                            styleClass="bid-button" text="Bắt đầu phiên đấu giá" />

                    <Button fx:id="endSessionButton" maxWidth="Infinity" onAction="#handleEndSession"
                            styleClass="end-session-button" text="Kết thúc phiên đấu giá" />

                    <VBox spacing="8">
                        <Label styleClass="info-label" text="Giá tối thiểu tiếp theo" />
                        <Label fx:id="nextMinBidLabel" styleClass="next-price" text="" />
                    </VBox>

                    <TextField fx:id="bidAmountField" promptText="Nhập giá của bạn" styleClass="bid-input" />

                    <Button fx:id="placeBidButton" maxWidth="Infinity" onAction="#handlePlaceBid"
                            styleClass="bid-button" text="Đặt giá ngay" />

                </VBox>

                <!-- Auto-bid panel -->
                <VBox spacing="12" styleClass="panel-card">

                    <Label styleClass="section-title" text="Đặt giá tự động" />

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <CheckBox fx:id="autoBidCheckBox" text="Bật đặt giá tự động"
                                  onAction="#handleAutoBidToggle" textFill="WHITE" />
                    </HBox>

                    <VBox spacing="6">
                        <Label styleClass="info-label" text="Giá tối đa sẵn sàng trả" />
                        <TextField fx:id="autoBidMaxField" promptText="VD: 5000000" styleClass="bid-input" />
                    </VBox>

                    <Label fx:id="autoBidStatusLabel" text="" wrapText="true"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />

                </VBox>

                <!-- Session info panel -->
                <VBox spacing="14" styleClass="panel-card">

                    <Label styleClass="section-title" text="Thông tin phiên" />

                    <HBox spacing="10">
                        <Label text="✔" />
                        <Label fx:id="sellerNameLabel" textFill="WHITE" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="✔" />
                        <Label fx:id="bidIncrementLabel" textFill="WHITE" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="✔" />
                        <Label fx:id="totalBidsLabel" textFill="WHITE" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="✔" />
                        <Label fx:id="participantsLabel" textFill="WHITE" />
                    </HBox>

                    <HBox spacing="10">
                        <Label text="✔" />
                        <Label fx:id="sessionStatusLabel" textFill="WHITE" />
                    </HBox>

                </VBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>
