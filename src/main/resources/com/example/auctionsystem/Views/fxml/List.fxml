<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bai_tap_lon.Controllers.ListController"

      style="
          -fx-background-color: #f4f7fb;
      ">

    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <children>

        <!-- Title -->
        <Label text="USER LIST"
               style="
                   -fx-font-size: 26px;
                   -fx-font-weight: bold;
                   -fx-text-fill: #172033;
               "/>

        <!-- Button Bar -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Button text="Dashboard"
                    onAction="#handleOpenDashboard"
                    style="
                        -fx-background-color: #3b82f6;
                        -fx-text-fill: white;
                        -fx-font-size: 13px;
                        -fx-padding: 8 20 8 20;
                        -fx-background-radius: 8;
                        -fx-cursor: hand;
                    "/>
        </HBox>

        <!-- Table Container -->
        <VBox spacing="10.0"
              style="
                  -fx-background-color: white;
                  -fx-background-radius: 14;
                  -fx-border-radius: 14;
                  -fx-border-color: #dbe3ef;
                  -fx-padding: 16;
              ">

            <children>

                <!-- Section Label -->
                <Label text="Danh sach nguoi dung"
                       style="
                           -fx-font-size: 18px;
                           -fx-font-weight: 700;
                           -fx-text-fill: #1e293b;
                       "/>

                <!-- Table -->
                <TableView fx:id="tableView"
                           prefHeight="500.0"
                           prefWidth="700.0"

                           style="
                               -fx-background-color: white;
                               -fx-border-color: #e5e7eb;
                               -fx-border-radius: 10;
                               -fx-background-radius: 10;
                               -fx-table-cell-border-color: transparent;
                           ">

                    <columns>

                        <TableColumn fx:id="usernameCol"
                                     prefWidth="220.0"
                                     text="Username"/>

                        <TableColumn fx:id="emailCol"
                                     prefWidth="320.0"
                                     text="Email"/>

                        <TableColumn fx:id="roleCol"
                                     prefWidth="140.0"
                                     text="Role"/>

                    </columns>

                </TableView>

            </children>

        </VBox>

    </children>

</VBox>