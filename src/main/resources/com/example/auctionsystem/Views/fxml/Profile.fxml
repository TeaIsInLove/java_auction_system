<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER"
      spacing="30"
      stylesheets="@../css/Dashboard.css"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.bai_tap_lon.Controllers.ProfileController"
      styleClass="profile-root">

    <padding>
        <Insets top="35" right="40" bottom="35" left="40"/>
    </padding>

    <!-- TITLE -->
    <VBox alignment="CENTER" spacing="6">

        <Label text="Thông Tin Cá Nhân"
               styleClass="page-title">

            <font>
                <Font size="32"/>
            </font>

        </Label>

        <Label text="Quản lý thông tin tài khoản của bạn"
               styleClass="subtitle-text"/>

    </VBox>

    <!-- PROFILE CARD -->
    <VBox alignment="TOP_CENTER"
          spacing="28"
          prefWidth="440"
          maxWidth="440"
          styleClass="profile-card">

        <padding>
            <Insets top="35" right="32" bottom="35" left="32"/>
        </padding>

        <!-- AVATAR -->
        <VBox alignment="CENTER" spacing="12">

            <Label text="👤"
                   styleClass="avatar-circle">

                <font>
                    <Font size="58"/>
                </font>

            </Label>

            <Label fx:id="usernameLabel"
                   styleClass="profile-username"/>

        </VBox>

        <!-- INFO SECTION -->
        <VBox spacing="16"
              prefWidth="360">

            <!-- EMAIL -->
            <HBox alignment="CENTER_LEFT"
                  spacing="16"
                  styleClass="profile-info-row">

                <VBox alignment="CENTER">
                    <Label text="✉"
                           styleClass="row-icon"/>
                </VBox>

                <VBox spacing="3">

                    <Label text="Email"
                           styleClass="info-label"/>

                    <Label fx:id="emailLabel"
                           styleClass="info-value"/>

                </VBox>

            </HBox>

            <!-- ROLE -->
            <HBox alignment="CENTER_LEFT"
                  spacing="16"
                  styleClass="profile-info-row">

                <VBox alignment="CENTER">
                    <Label text="◆"
                           styleClass="row-icon"/>
                </VBox>

                <VBox spacing="3">

                    <Label text="Vai trò"
                           styleClass="info-label"/>

                    <Label fx:id="roleLabel"
                           styleClass="info-value"/>

                </VBox>

            </HBox>

            <!-- BALANCE -->
            <HBox alignment="CENTER_LEFT"
                  spacing="16"
                  styleClass="profile-info-row balance-row">

                <VBox alignment="CENTER">

                    <Label text="S"
                           styleClass="money-icon"/>

                </VBox>

                <VBox spacing="3">

                    <Label text="Số dư"
                           styleClass="info-label"/>

                    <Label fx:id="balanceLabel"
                           styleClass="balance-text"/>

                </VBox>

            </HBox>

            <!-- CREATED AUCTIONS -->
            <HBox alignment="CENTER_LEFT"
                  spacing="16"
                  styleClass="profile-info-row">

                <VBox alignment="CENTER">
                    <Label text="▣"
                           styleClass="row-icon"/>
                </VBox>

                <VBox spacing="3">

                    <Label text="Phiên đã tạo"
                           styleClass="info-label"/>

                    <Label fx:id="createdAuctionsLabel"
                           styleClass="info-value"/>

                </VBox>

            </HBox>

        </VBox>

        <Region prefHeight="8"/>

        <!-- BUTTON -->
        <Button text="Đóng"
                onAction="#handleClose"
                prefWidth="180"
                prefHeight="44"
                styleClass="close-button"/>

    </VBox>

</VBox>